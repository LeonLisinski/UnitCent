{
  "expo": {
    "name": "UnitCent",
    "slug": "unitcent",
    "scheme": "unitcent",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070b0b",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.unitcent.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.unitcent.app",
      "adaptiveIcon": {
        "backgroundColor": "#070b0b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "UnitCent koristi kameru samo za skeniranje računa."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UnitCent čita sliku računa koju odabereš."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "UnitCent koristi Face ID za otključavanje aplikacije."
        }
      ],
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "organization": "unitlift",
          "project": "unitcent"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5d5b3c14-f16e-4582-98c0-78777d4ed790"
      }
    },
    "owner": "leonlis"
  }
}
