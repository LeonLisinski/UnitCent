{
  "expo": {
    "name": "UnitCent",
    "slug": "unitcent",
    "scheme": "unitcent",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070b0b",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.unitcent.app"
    },
    "android": {
      "package": "com.unitcent.app",
      "adaptiveIcon": {
        "backgroundColor": "#070b0b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "UnitCent koristi kameru samo za skeniranje računa."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UnitCent čita sliku računa koju odabereš."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "unitlift",
          "project": "unitcent"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
