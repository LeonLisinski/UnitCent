# Kopiraj u .env.local (ne ulazi u git). Samo javni ključevi: smiju u aplikaciju.
EXPO_PUBLIC_SUPABASE_URL=https://TVOJ-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# 1 = prikaži Apple prijavu na iOS-u (kad je Apple provider podešen u Supabaseu)
EXPO_PUBLIC_APPLE_SIGNIN=0

# Praćenje grešaka (Sentry, EU): DSN iz Sentry projekta (Settings → Client Keys). Prazno = isključeno.
EXPO_PUBLIC_SENTRY_DSN=
# Anonimna statistika (PostHog EU): "Project API key" (phc_...). Prazno = isključeno.
EXPO_PUBLIC_POSTHOG_KEY=
# Kupnja (RevenueCat): javni SDK ključevi za iOS i Android. Prazno = kupnja nedostupna.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
